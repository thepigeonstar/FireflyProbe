ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_RANDOM_CHARACTERS
PUBLIC_URL=https://monitor.example.com
DOMAIN=monitor.example.com
COOKIE_SECURE=true
TIMEZONE=Asia/Shanghai

# Optional: comma-separated exact proxy IPs/CIDRs. Setting this overrides auto detection.
# Default trusts loopback, the actual Docker gateway, and the companion Caddy only.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.18.0.1/32
